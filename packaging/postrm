#!/bin/sh
set -e
if [ -d /run/systemd/system ]; then
  systemctl daemon-reload
fi
if [ "$1" = purge ]; then
  deb-systemd-helper purge decklab.service >/dev/null || true
  deb-systemd-helper purge decklab-web.service >/dev/null || true
  deb-systemd-helper purge decklab-backend.service >/dev/null || true
  deb-systemd-helper purge decklab-collector.service >/dev/null || true
fi
# Registry and logs deliberately survive remove/purge for operator-controlled retention.
