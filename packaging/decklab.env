DECKLAB_BASE=/data/decklab-data
DECKLAB_STATIC=/usr/lib/decklab
DECKLAB_SOCKET=/run/decklab/collector.sock
# Set a long random value unless the host is restricted to a trusted network.
DECKLAB_AUTH_TOKEN=
# Optional JSON map of agent labels to distinct bearer tokens (requires AUTH_TOKEN).
# DECKLAB_AGENT_TOKENS_FILE=/etc/decklab/agent-tokens.json
DECKLAB_BIND=0.0.0.0
DECKLAB_PORT=8898
DECKLAB_RESCUE_BIN=/usr/libexec/decklab/rescue.sh
DECKLAB_SSH_USER=root
DECKLAB_SSH_PASSWORD=bianbu
# Optional per-board profiles; see /usr/share/doc/decklab/reference/environment.md.
# DECKLAB_PROFILES=/etc/decklab/profiles.json
# DECKLAB_BAUD=115200
# DECKLAB_CONSOLE_USER=ubuntu
# DECKLAB_CONSOLE_PASSWORD=your-board-password
# Set 0 to preserve the board's password and sshd policy.
# DECKLAB_AUTO_CONFIGURE_SSH=0
# Use manual for raw firmware terminals without Linux shell probes.
# DECKLAB_PROBE=manual
# Retain all logs by default. Opt in to removal of old daily archives.
# DECKLAB_LOG_RETENTION_DAYS=30
# DECKLAB_DISK_MIN_FREE_MB=1024
# DECKLAB_DISK_MIN_FREE_PERCENT=5

# Split nodes: Web connects to one authenticated HTTPS hardware backend.
# See /usr/share/doc/decklab/modules/distributed-nodes.md for Windows and Ubuntu roles.
# Web node only:
# DECKLAB_BACKEND_URL=https://backend.example:8899
# DECKLAB_BACKEND_CA=/etc/decklab/backend-ca.pem
# Both nodes use the same independent, randomly generated node credential:
# DECKLAB_BACKEND_TOKEN=
# Hardware backend only:
# DECKLAB_BACKEND_BIND=0.0.0.0
# DECKLAB_BACKEND_PORT=8899
# DECKLAB_BACKEND_CERT=/etc/decklab/backend.pem
# DECKLAB_BACKEND_KEY=/etc/decklab/backend.key

# Optional backend-local prebuilt RAM-only FSBL/U-Boot manifest.
# DECKLAB_FLASH_LOADERS=/usr/lib/decklab/flash-loaders/manifest.json
