[Unit]
Description=Prepare TitanX station credentials
After=decklab.service
Requires=decklab.service
ConditionPathExists=/etc/decklab/titanx.json

[Service]
Type=oneshot
User=decklab
Group=decklab
EnvironmentFile=/etc/decklab/decklab.env
Environment=PYTHONPATH=/usr/lib/decklab
ExecStart=/usr/bin/python3 -m decklab_core.titanx_workbench
RuntimeDirectory=decklab-titanx-config
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
TimeoutStartSec=infinity
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
