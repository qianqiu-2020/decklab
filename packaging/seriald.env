SERIALD_BASE=/data/seriald-data
SERIALD_STATIC=/usr/lib/seriald
SERIALD_SOCKET=/run/seriald/collector.sock
# Set a long random value unless the host is restricted to a trusted network.
SERIALD_AUTH_TOKEN=
# Optional JSON map of agent labels to distinct bearer tokens (requires AUTH_TOKEN).
# SERIALD_AGENT_TOKENS_FILE=/etc/seriald/agent-tokens.json
SERIALD_BIND=0.0.0.0
SERIALD_PORT=8898
SERIALD_RESCUE_BIN=/usr/libexec/seriald/rescue.sh
SERIALD_SSH_USER=root
SERIALD_SSH_PASSWORD=bianbu
# Optional per-board profiles; see /usr/share/doc/seriald/CONFIGURATION.md.
# SERIALD_PROFILES=/etc/seriald/profiles.json
# SERIALD_BAUD=115200
# SERIALD_CONSOLE_USER=ubuntu
# SERIALD_CONSOLE_PASSWORD=your-board-password
# Set 0 to preserve the board's password and sshd policy.
# SERIALD_AUTO_CONFIGURE_SSH=0
# Use manual for raw firmware terminals without Linux shell probes.
# SERIALD_PROBE=manual
# Retain all logs by default. Opt in to removal of old daily archives.
# SERIALD_LOG_RETENTION_DAYS=30
# SERIALD_DISK_MIN_FREE_MB=1024
# SERIALD_DISK_MIN_FREE_PERCENT=5

# Split nodes: Web connects to one authenticated HTTPS hardware backend.
# See /usr/share/doc/seriald/DISTRIBUTED.md for Windows and Ubuntu roles.
# Web node only:
# SERIALD_BACKEND_URL=https://backend.example:8899
# SERIALD_BACKEND_CA=/etc/seriald/backend-ca.pem
# Both nodes use the same independent, randomly generated node credential:
# SERIALD_BACKEND_TOKEN=
# Hardware backend only:
# SERIALD_BACKEND_BIND=0.0.0.0
# SERIALD_BACKEND_PORT=8899
# SERIALD_BACKEND_CERT=/etc/seriald/backend.pem
# SERIALD_BACKEND_KEY=/etc/seriald/backend.key

# Optional backend-local prebuilt RAM-only FSBL/U-Boot manifest.
# SERIALD_FLASH_LOADERS=/usr/lib/seriald/flash-loaders/manifest.json
