[Unit]
Description=DeckLab authenticated TLS hardware backend (serial, USB and reset)
After=network-online.target local-fs.target
Wants=network-online.target
Conflicts=decklab.service decklab-collector.service decklab-web.service

[Service]
Type=simple
User=decklab
Group=decklab
SupplementaryGroups=dialout
EnvironmentFile=/etc/decklab/decklab.env
Environment=HOME=/data/decklab-data
WorkingDirectory=/usr/lib/decklab
ExecStart=/usr/bin/decklab-backend
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
