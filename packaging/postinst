#!/bin/sh
set -e
case "$1" in
  configure)
    PYTHONPATH=/usr/lib/decklab /usr/bin/python3 -m decklab_core.migrate_debian
    if ! getent passwd decklab >/dev/null; then
      adduser --system --group --home /data/decklab-data --no-create-home decklab
    fi
    if [ "$(id -gn decklab)" != decklab ]; then
      echo 'DeckLab requires the decklab service group.' >&2
      exit 1
    fi
    if [ -x /usr/libexec/decklab/titanx/edge ]; then
      install -d -o decklab -g decklab -m 0700 /var/lib/decklab-workbench
    fi
    adduser decklab dialout
    install -d -o decklab -g decklab -m 2770 /data/decklab-data
    if [ -z "${2:-}" ] || dpkg --compare-versions "$2" lt 1.3.2; then
      find /data/decklab-data -xdev -type d -exec chown decklab:decklab {} + -exec chmod 2770 {} +
      find /data/decklab-data -xdev -type f -exec chown decklab:decklab {} +
      # Retained owner-only data may contain credentials, including after a
      # purge/fresh install. Do not widen its permissions during legacy repair.
      find /data/decklab-data -xdev -type f -perm /0077 -exec chmod 0660 {} +
    fi
    # Tighten old registries and snapshots before starting any service. Backups
    # may already contain SSH passwords and are not reopened by Store startup.
    find /data/decklab-data -xdev -maxdepth 1 -type f \
      \( -name registry.sqlite3 -o -name registry.sqlite3-wal -o -name registry.sqlite3-shm \
      -o -name registry.sqlite3-journal \) -exec chmod 0600 {} +
    if [ -d /data/decklab-data/backups ]; then
      find /data/decklab-data/backups -xdev -type f -exec chmod 0600 {} +
    fi
    chown root:decklab /etc/decklab/decklab.env
    chmod 0640 /etc/decklab/decklab.env
    if [ -f /lib/udev/rules.d/70-decklab-fastboot.rules ] && command -v udevadm >/dev/null 2>&1; then
      # A change event updates access permissions, without resetting USB or
      # changing the single-reader ownership of serial connections.
      udevadm control --reload-rules || true
      udevadm trigger --action=change --subsystem-match=usb --attr-match=idVendor=361c || true
    fi
    if [ -d /run/systemd/system ]; then
      restart_marker=/run/decklab-collector-restart-required
      systemctl daemon-reload
      # Package helpers may return success without running a unit (policy-rc.d).
      # Preserve service policy in images and keep failures visible to dpkg.
      deferred=false
      service_action() {
        action=$1 unit=$2
        if [ -x /usr/sbin/policy-rc.d ]; then
          policy=0
          /usr/sbin/policy-rc.d "$unit" "$action" >/dev/null || policy=$?
          if [ "$policy" = 101 ]; then
            echo "decklab: $action $unit deferred by policy-rc.d"
            deferred=true
            return 0
          fi
        fi
        if [ "$action" != stop ] && systemctl is-failed --quiet "$unit"; then
          systemctl reset-failed "$unit"
        fi
        if ! deb-systemd-invoke "$action" "$unit" ||
           { [ "$action" != stop ] && ! systemctl is-active --quiet "$unit"; }; then
          echo "decklab: $action $unit failed; see journalctl -u $unit -b" >&2
          systemctl --no-pager --lines=0 status "$unit" >&2 || true
          return 1
        fi
      }
      # Adopt the old node role when apt removed its unit files.
      if ! systemctl is-enabled --quiet decklab.service &&
         ! systemctl is-enabled --quiet decklab-web.service &&
         ! systemctl is-enabled --quiet decklab-backend.service; then
        for role in web backend; do
          if [ -L "/etc/systemd/system/multi-user.target.wants/seriald-$role.service" ]; then
            deb-systemd-helper enable "decklab-$role.service" >/dev/null
            break
          fi
        done
      fi
      if systemctl is-enabled --quiet decklab-web.service; then
        service_action restart decklab-web.service
      elif systemctl is-enabled --quiet decklab-backend.service; then
        if systemctl is-active --quiet decklab-backend.service && [ ! -e "$restart_marker" ]; then
          echo "decklab: hardware backend kept running (code unchanged)"
        else
          service_action restart decklab-backend.service
        fi
      else
        deb-systemd-helper enable decklab-collector.service >/dev/null
        deb-systemd-helper enable decklab.service >/dev/null
        if systemctl is-active --quiet decklab-collector.service; then
          if [ -e "$restart_marker" ]; then
            service_action restart decklab-collector.service
            $deferred || echo "decklab: collector restarted (collector code changed)"
          else
            echo "decklab: collector kept running (collector code unchanged)"
          fi
        else
          # A pre-split package can still hold the serial ports in decklab.service.
          if [ -n "${2:-}" ] && systemctl is-active --quiet decklab.service; then
            service_action stop decklab.service
          fi
          service_action start decklab-collector.service
          $deferred || echo "decklab: collector started (was not running)"
        fi
        if [ -e /lib/systemd/system/decklab-titanx.path ]; then
          deb-systemd-helper enable decklab-titanx.path decklab-titanx-boards.path >/dev/null
        fi
        service_action restart decklab.service
        if [ -e /lib/systemd/system/decklab-titanx.path ]; then
          service_action restart decklab-titanx.path
          service_action restart decklab-titanx-boards.path
          # A running standalone worker can survive the web service restart.
          # Load the installed Edge when dpkg replaced its executable.
          edge_pid=$(systemctl show -p MainPID --value decklab-titanx.service)
          if [ "${edge_pid:-0}" -gt 0 ] && [ -e "/proc/$edge_pid/exe" ] &&
             ! [ "/proc/$edge_pid/exe" -ef /usr/libexec/decklab/titanx/edge ]; then
            service_action restart decklab-titanx.service
          fi
        fi
      fi
      if $deferred; then exit 0; fi
      rm -f "$restart_marker"
    fi
    PYTHONPATH=/usr/lib/decklab /usr/bin/python3 - <<'PY' || echo "decklab: could not determine access addresses" >&2
import re
from pathlib import Path
from decklab_core.control_server import lan_hosts
from decklab_core.network import url_host

config = Path('/etc/decklab/decklab.env').read_text(encoding='utf-8')
def setting(name, default):
    match = re.search(r'^' + name + r'=(.*)$', config, re.MULTILINE)
    return match.group(1).strip().strip('"\'') if match else default

port = setting('DECKLAB_PORT', '8898')
bind = setting('DECKLAB_BIND', '0.0.0.0')
print('decklab: web and agent access:')
if bind in ('0.0.0.0', '::', '127.0.0.1', 'localhost'):
    print(f'  local: http://127.0.0.1:{port}/')
if bind in ('0.0.0.0', '::'):
    hosts = lan_hosts()
    for host in hosts:
        print(f'  LAN:   http://{url_host(host)}:{port}/')
    if not hosts:
        print('  LAN:   no shareable address detected; check network configuration')
elif bind not in ('127.0.0.1', 'localhost'):
    print(f'  bind:  http://{url_host(bind)}:{port}/')
PY
    # Reuse the running service's existing share-link/cookie protocol. No node
    # enrollment, collector restart, key copying or extra client installation.
    if [ -d /run/systemd/system ] && ! systemctl is-enabled --quiet decklab-backend.service; then
      /usr/bin/decklab-access --wait 20 || true
    fi
    ;;
esac
