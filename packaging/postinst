#!/bin/sh
set -e
case "$1" in
  configure)
    if ! getent passwd seriald >/dev/null; then
      adduser --system --group --home /data/seriald-data --no-create-home seriald
    fi
    adduser seriald dialout
    install -d -o seriald -g seriald -m 2770 /data/seriald-data
    if [ -z "${2:-}" ] || dpkg --compare-versions "$2" lt 1.3.2; then
      find /data/seriald-data -xdev -type d -exec chown seriald:seriald {} + -exec chmod 2770 {} +
      find /data/seriald-data -xdev -type f -exec chown seriald:seriald {} +
      # Retained owner-only data may contain credentials, including after a
      # purge/fresh install. Do not widen its permissions during legacy repair.
      find /data/seriald-data -xdev -type f -perm /0077 -exec chmod 0660 {} +
    fi
    # Tighten old registries and snapshots before starting any service. Backups
    # may already contain SSH passwords and are not reopened by Store startup.
    find /data/seriald-data -xdev -maxdepth 1 -type f \
      \( -name registry.sqlite3 -o -name registry.sqlite3-wal -o -name registry.sqlite3-shm \
      -o -name registry.sqlite3-journal \) -exec chmod 0600 {} +
    if [ -d /data/seriald-data/backups ]; then
      find /data/seriald-data/backups -xdev -type f -exec chmod 0600 {} +
    fi
    chown root:seriald /etc/seriald/seriald.env
    chmod 0640 /etc/seriald/seriald.env
    if [ -f /lib/udev/rules.d/70-seriald-fastboot.rules ] && command -v udevadm >/dev/null 2>&1; then
      # A change event updates access permissions, without resetting USB or
      # changing the single-reader ownership of serial connections.
      udevadm control --reload-rules || true
      udevadm trigger --action=change --subsystem-match=usb --attr-match=idVendor=361c || true
    fi
    if [ -d /run/systemd/system ]; then
      restart_marker=/run/seriald-collector-restart-required
      systemctl daemon-reload
      # Keep the administrator-selected node role during upgrades. Remote Web
      # upgrades must never enable a local hardware collector.
      if systemctl is-enabled --quiet seriald-web.service; then
        deb-systemd-invoke restart seriald-web.service || true
      elif systemctl is-enabled --quiet seriald-backend.service; then
        if systemctl is-active --quiet seriald-backend.service && [ ! -e "$restart_marker" ]; then
          echo "seriald: hardware backend kept running (code unchanged)"
        else
          deb-systemd-invoke restart seriald-backend.service || true
        fi
      else
        deb-systemd-helper enable seriald-collector.service >/dev/null
        deb-systemd-helper enable seriald.service >/dev/null
        if systemctl is-active --quiet seriald-collector.service; then
          # preinst compares the previous and incoming collector fingerprints before
          # dpkg overwrites either copy. UI/control-only upgrades preserve tty and SSH.
          if [ -n "${2:-}" ] && [ -e "$restart_marker" ]; then
            if deb-systemd-invoke restart seriald-collector.service; then
              echo "seriald: collector restarted (collector code changed)"
            else
              echo "seriald: collector restart failed" >&2
            fi
          else
            echo "seriald: collector kept running (collector code unchanged)"
          fi
        else
          if deb-systemd-invoke start seriald-collector.service; then
            echo "seriald: collector started (was not running)"
          else
            echo "seriald: collector start failed" >&2
          fi
        fi
        deb-systemd-invoke restart seriald.service || true
      fi
      rm -f "$restart_marker"
    fi
    PYTHONPATH=/usr/lib/seriald /usr/bin/python3 - <<'PY' || echo "seriald: could not determine access addresses" >&2
import re
from pathlib import Path
from seriald_core.control_server import lan_hosts

config = Path('/etc/seriald/seriald.env').read_text(encoding='utf-8')
def setting(name, default):
    match = re.search(r'^' + name + r'=(.*)$', config, re.MULTILINE)
    return match.group(1).strip().strip('"\'') if match else default

port = setting('SERIALD_PORT', '8898')
bind = setting('SERIALD_BIND', '0.0.0.0')
print('seriald: web and agent access:')
if bind in ('0.0.0.0', '127.0.0.1', 'localhost'):
    print(f'  local: http://127.0.0.1:{port}/')
if bind == '0.0.0.0':
    hosts = lan_hosts()
    for host in hosts:
        print(f'  LAN:   http://{host}:{port}/')
    if not hosts:
        print('  LAN:   no private IPv4 address detected; check network configuration')
elif bind not in ('127.0.0.1', 'localhost'):
    print(f'  bind:  http://{bind}:{port}/')
PY
    # Reuse the running service's existing share-link/cookie protocol. No node
    # enrollment, collector restart, key copying or extra client installation.
    if [ -d /run/systemd/system ] && ! systemctl is-enabled --quiet seriald-backend.service; then
      /usr/bin/seriald-access || true
    fi
    ;;
esac
