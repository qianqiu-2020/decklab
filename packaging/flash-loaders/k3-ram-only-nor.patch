@@ -739,0 +740,7 @@ int board_init(void)
+#if CONFIG_IS_ENABLED(DECKLAB_RAM_ONLY_LOADER)
+    /* Keep boot regulators, but do not initialize optional EC/retimer devices
+     * or run their provisioning paths in a temporary download environment.
+     */
+    return ret;
+#endif
+
@@ -954,0 +962,8 @@ int board_late_init(void)
+#if CONFIG_IS_ENABLED(DECKLAB_RAM_ONLY_LOADER)
+    /* RAM-stage service only. Do not provision EEPROM identities, persist
+     * DDR training data, import board scripts or auto-flash attached media.
+     * A host-confirmed fastboot flash is the only storage-writing path here.
+     */
+    for (;;)
+        run_command("fastboot 0", 0);
+#endif
