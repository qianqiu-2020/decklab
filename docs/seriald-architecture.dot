digraph seriald {
  graph [label="DeckLab · 开发板访问与记录架构", labelloc=t, fontsize=26,
         fontname="Noto Sans CJK SC", fontcolor="#193438", bgcolor="#f6f8f6",
         pad=0.32, nodesep=0.48, ranksep=0.9, splines=polyline, rankdir=LR];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC",
        fontsize=15, color="#c5d5d0", fillcolor="#ffffff", fontcolor="#193438",
        penwidth=1.3, margin="0.20,0.13"];
  edge [color="#4e7975", penwidth=1.8, arrowsize=0.8,
        fontname="Noto Sans CJK SC", fontsize=12, fontcolor="#44645f"];

  web [label="人 · 多个网页\n实时终端 / 日志 / 文件传输", fillcolor="#e3f1ec"];
  agent [label="Agent · serialctl\n命令 / 会话 / 文件传输", fillcolor="#e3f1ec"];

  subgraph cluster_host {
    label="上位机 · seriald";
    fontname="Noto Sans CJK SC"; fontsize=18; fontcolor="#2d5754";
    color="#b9d1ca"; style="rounded,filled"; fillcolor="#edf3ef";
    control [label="HTTP 控制面\n静态页面 + API 代理", fillcolor="#d8e8e2"];
    collector [label="Collector\n设备注册 / 连接代次 / 操作互斥", fillcolor="#c4ddd4"];
    reader [label="每端口唯一读者\n持续采集串口字节", fillcolor="#ffffff"];
    writer [label="串口写通路\nLinux: 独立只写 fd\nWindows: 同一 COM 句柄", fillcolor="#ffffff"];
    ssh [label="SSH 会话\nLinux PTY / Windows SSH channel\n人可旁观", fillcolor="#ffffff"];
    store [label="序列号档案\nSQLite + 每日串口 / SSH 日志", fillcolor="#dce8f3"];
  }

  board_a [label="开发板 A\n串口 + Linux shell", fillcolor="#f7ecdc", color="#dfc7a4"];
  board_b [label="开发板 B\n串口 + Linux shell", fillcolor="#f7ecdc", color="#dfc7a4"];

  web -> control [label="POST 输入 / SSE 推送\nGET off 作为回退"];
  agent -> control;
  control -> collector [label="本机 IPC"];
  collector -> reader;
  collector -> writer;
  collector -> ssh;
  collector -> store [label="身份 / 事件"];
  reader -> store [label="归档"];
  ssh -> store [label="会话记录"];
  reader -> board_a [dir=back, label="串口输出"];
  writer -> board_a [label="命令 / 分块"];
  reader -> board_b [dir=back, label="串口输出"];
  writer -> board_b [label="命令 / 分块"];
  ssh -> board_a [label="网络 SSH", style=dashed];

  pipeline [shape=note, label="板间复制流水线\nA 读取下一块  ∥  B 写入当前块\n每块确认；最终校验原文件 SHA-256",
            fillcolor="#fff8e9", color="#dfc7a4", fontsize=13];
  collector -> pipeline [style=dotted, arrowhead=none];
}
