# Upstream notice bytes are pinned by SHA-256; never rewrite their line endings.
packaging/third-party/** -text
# Preserve upstream license whitespace too; integrity is checked by pinned hashes.
packaging/third-party/native-source-notices/** -whitespace
packaging/third-party/linux-mcp-native-notices/** -whitespace
vendor/terminal/** -text
# noVNC source and notices are verified against their upstream byte hashes.
vendor/novnc/** -text -whitespace
# Ace source and notices are verified against the npm distribution byte hashes.
vendor/ace/** -text -whitespace
vendor/python/** -text
# The prepared desktop SDK records these source bytes on both build hosts.
native/freerdp/** text eol=lf

# Binary build inputs and their notices are authenticated byte for byte.
packaging/flash-components/** -text
# Loader source patches are recorded by SHA-256 in the RAM loader build info.
packaging/flash-loaders/patches/** -text -whitespace
packaging/flash-components/common/flash-loaders/patches/** -whitespace
# Hook scripts run under sh on every platform, including Git for Windows.
.githooks/** text eol=lf
tools/install_hooks.sh text eol=lf
